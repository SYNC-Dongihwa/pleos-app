<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!--
        튜토리얼 단계가 구독하는 Vehicle SDK 조회 퍼미션만 선언한다 (CLAUDE.md §5 체크리스트).
        App Market 사전 승인 대상 — 단계를 추가·삭제하면 이 목록과 체크리스트를 같이 고칠 것.
    -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />   <!-- 전조등·상향등·방향지시등 -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />  <!-- 창문·와이퍼 -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />  <!-- A/C·온도·핸들 열선 -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />    <!-- 도어 잠금·트렁크·운전석 문 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />    <!-- 주행 모드 -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />    <!-- 시트 열선 -->
    <!-- Pleos TextToSpeech: SDK ApiChecker가 확인, 없으면 SecurityException (2026-10-22 실측) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- AAOS 표준 GEAR_SELECTION·PARKING_BRAKE_ON (정차 게이트). Pleos 문서: 기어 등 표준 데이터는 AAOS Car API로 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- AAOS 표준 FUEL_DOOR_OPEN·EV_CHARGE_PORT_OPEN (주유·충전 코스). Pleos SDK에 주유구 API가 없음 -->
    <uses-permission android:name="android.car.permission.CAR_ENERGY_PORTS" />

    <application
        android:name=".PleosApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- 정차 중에만 쓰는 앱이라 DO를 선언하지 않는다: 주행 중엔 시스템이 화면을 가리고, 앱은 정차 게이트로 일시정지 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
