<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!--
        SDK Probe 단계: 모든 도메인의 조회(check/get/register) API를 호출하므로 조회 퍼미션 전체를 선언한다.
        퍼미션 목록은 AAR Impl 클래스의 @RequiresCustomPermission 집계 결과 (CLAUDE.md §9 2026-10-22).
        ⚠️ 실제 앱 기능이 정해지면 쓰는 것만 남길 것 (미사용 퍼미션 = 앱마켓 심사 반려 사유).
    -->
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />   <!-- HVAC, SteeringWheel 열선 -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />     <!-- Door -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />     <!-- Brake, DrivingMode, Gear, Odometer, SteeringWheel 각도 -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />    <!-- EvBattery, Fuel -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />      <!-- CarInfo, Display, EvBattery 용량 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />    <!-- Light, TurnSignal -->
    <uses-permission android:name="pleos.car.permission.CAR_MIRRORS" />   <!-- SideMirror -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />    <!-- Safety, Tire -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />     <!-- Seat -->
    <uses-permission android:name="pleos.car.permission.CAR_TOLL" />      <!-- Toll -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />   <!-- Window, Wiper -->
    <!-- PRIVATE_*: 3rd-party 앱에 부여되는지 확인용 (CarInfo.getCapabilityInfo, Safety 경고등, Tire 공기압) -->
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_INFO" />
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />
    <!-- NaviHelper get*Info() -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- NaviHelper requestRoute()/requestRouteWithWaypoints()/addWaypoint()/removeWaypoint()/cancelRoute() -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- 상시 수신 Foreground Service (Android 14: 타입별 권한 필요) + 주행 알림 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PleosApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <!-- 홈: DO 선언 → 주행 중에도 표시, 대신 CarUxRestrictions로 화면을 직접 줄인다 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
        <!-- SDK Probe: DO 미선언 (텍스트 과다 → 주행 중 시스템이 가림) -->
        <activity
            android:name=".ProbeActivity"
            android:exported="false" />

        <service
            android:name=".service.MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps receiving vehicle state (warning lights, battery) and navigation events while another app such as Navigation is in front, to show glanceable driver alerts." />
        </service>
    </application>
</manifest>
